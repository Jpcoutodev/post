# Database (Postgres - Supabase, Neon, Railway, local etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/post?schema=public"

# n8n webhooks
N8N_FIRST_IMAGE_WEBHOOK_URL="https://your-n8n.example.com/webhook/first-image"
N8N_CONTINUATION_WEBHOOK_URL="https://your-n8n.example.com/webhook/continuation"
# Optional shared secret sent as X-Webhook-Secret header
N8N_WEBHOOK_SECRET=""
